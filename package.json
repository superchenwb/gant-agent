{
  "name": "gant-agent",
  "version": "0.2.3",
  "description": "团队级 AI 业务知识库管理工具",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gant": "dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "templates/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "ai-agent",
    "skill-manager",
    "knowledge-base",
    "omc",
    "opencode"
  ],
  "author": "Gant Team",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.15",
    "js-yaml": "^4.1.0",
    "ora": "^8.0.1",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "bun-types": "1.3.12",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.8.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
